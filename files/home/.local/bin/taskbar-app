#!/usr/bin/env python3
"""
taskbar-app - Launch, focus, or toggle the application at taskbar position N.

Behavior (matching Windows taskbar shortcuts Win+1..0):
- If the app at position N is not running: launch it.
- If the app at position N has 1 running window:
  - If focused: minimize it (toggle).
  - If unfocused/minimized: focus / restore it.
- If the app at position N has multiple running windows:
  - If one window is focused: cycle to the next window.
  - If none is focused: focus the first window.
- If --new is given (Win+Shift+1..0): launch a new instance.
- If --list is given: print current taskbar positions, pinned status, and windows.
"""

import ast
import glob
import os
import re
import shlex
import shutil
import subprocess
import sys
import tomllib


def parse_desktop_file(path: str) -> dict:
    """Parse key fields from a .desktop file."""
    info = {"path": path}
    in_entry = False
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line == "[Desktop Entry]":
                    in_entry = True
                    continue
                elif line.startswith("["):
                    in_entry = False
                    continue
                if in_entry and "=" in line:
                    k, v = line.split("=", 1)
                    info[k.strip()] = v.strip()
    except Exception:
        pass
    return info


def clean_exec_command(exec_str: str) -> list[str]:
    """Remove desktop field codes like %u, %U, %f, %F, etc. from Exec line."""
    try:
        tokens = shlex.split(exec_str)
    except Exception:
        tokens = exec_str.split()
    return [t for t in tokens if not re.match(r"^%[a-zA-Z]$", t)]


def load_desktop_entries() -> tuple[dict[str, dict], dict[str, str]]:
    """Scan standard desktop directories and return (desktop_map, alias_to_id)."""
    search_dirs = [
        os.path.expanduser("~/.local/share/applications"),
        "/usr/local/share/applications",
        "/usr/share/applications",
        "/var/lib/flatpak/exports/share/applications",
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
    ]
    desktop_map: dict[str, dict] = {}
    alias_map: dict[str, str] = {}

    for d in search_dirs:
        if not os.path.isdir(d):
            continue
        for f in glob.glob(os.path.join(d, "**/*.desktop"), recursive=True):
            base = os.path.basename(f)
            app_id = base[:-8] if base.endswith(".desktop") else base
            if app_id not in desktop_map:
                info = parse_desktop_file(f)
                info["id"] = app_id
                desktop_map[app_id] = info

                alias_map[app_id.lower()] = app_id
                wm = info.get("StartupWMClass")
                if wm:
                    alias_map[wm.lower()] = app_id
                    alias_map[wm] = app_id
                exec_line = info.get("Exec")
                if exec_line:
                    tokens = clean_exec_command(exec_line)
                    if tokens:
                        exe_name = os.path.basename(tokens[0])
                        alias_map[exe_name.lower()] = app_id

    return desktop_map, alias_map


def get_pinned_apps() -> list[str]:
    """Retrieve pinned app IDs from Noctalia daemon or config files."""
    # 1. Try running noctalia IPC
    try:
        out = subprocess.check_output(
            ["noctalia", "msg", "config-get", "widget.taskbar.pinned"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=0.6,
        ).strip()
        if out.startswith("[") and out.endswith("]"):
            res = ast.literal_eval(out)
            if isinstance(res, list):
                return [str(x) for x in res]
    except Exception:
        pass

    # 2. Check settings.toml (Noctalia UI state) then config.toml
    config_paths = [
        os.path.expanduser("~/.local/state/noctalia/settings.toml"),
        os.path.expanduser("~/.config/noctalia/config.toml"),
    ]
    for p in config_paths:
        if os.path.isfile(p):
            try:
                with open(p, "rb") as f:
                    data = tomllib.load(f)
                    pinned = data.get("widget", {}).get("taskbar", {}).get("pinned")
                    if isinstance(pinned, list) and pinned:
                        return [str(x) for x in pinned]
            except Exception:
                pass

    return []


def get_running_windows() -> list[dict]:
    """Get active toplevel windows via wlrctl."""
    try:
        out = subprocess.check_output(
            ["wlrctl", "toplevel", "list"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=0.8,
        )
    except Exception:
        return []

    windows = []
    for line in out.strip().splitlines():
        if ": " in line:
            app_id, title = line.split(": ", 1)
            windows.append({"app_id": app_id.strip(), "title": title.strip()})
    return windows


def match_window_to_app(win: dict, app_id: str, desktop_map: dict, alias_map: dict) -> bool:
    """Check if a window corresponds to a target app ID."""
    w_id = win["app_id"]
    w_lower = w_id.lower()
    t_lower = app_id.lower()

    if w_lower == t_lower:
        return True

    # Check via alias map
    if alias_map.get(w_lower) == app_id or alias_map.get(w_id) == app_id:
        return True

    # Check target's desktop entry
    info = desktop_map.get(app_id)
    if info:
        wm = info.get("StartupWMClass")
        if wm and (wm.lower() == w_lower or wm == w_id):
            return True
        exec_line = info.get("Exec")
        if exec_line:
            tokens = clean_exec_command(exec_line)
            if tokens and os.path.basename(tokens[0]).lower() == w_lower:
                return True

    return False


def build_taskbar(desktop_map: dict, alias_map: dict) -> list[dict]:
    """Construct the ordered list of taskbar items (pinned first, then unpinned running)."""
    pinned = get_pinned_apps()
    windows = get_running_windows()

    taskbar_items: list[dict] = []
    matched_window_indices = set()

    # 1. Pinned items
    for pin in pinned:
        matched_wins = []
        for idx, w in enumerate(windows):
            if idx not in matched_window_indices and match_window_to_app(w, pin, desktop_map, alias_map):
                matched_wins.append(w)
                matched_window_indices.add(idx)
        taskbar_items.append({"id": pin, "pinned": True, "windows": matched_wins})

    # 2. Unpinned running apps
    for idx, w in enumerate(windows):
        if idx in matched_window_indices:
            continue
        w_id = w["app_id"]
        norm_id = alias_map.get(w_id.lower(), alias_map.get(w_id, w_id))

        # Group multiple windows of the same unpinned app
        existing = next(
            (item for item in taskbar_items if match_window_to_app(w, item["id"], desktop_map, alias_map)),
            None,
        )
        if existing:
            existing["windows"].append(w)
        else:
            taskbar_items.append({"id": norm_id, "pinned": False, "windows": [w]})
        matched_window_indices.add(idx)

    return taskbar_items


def is_window_active(win: dict, only_window: bool = False) -> bool:
    """Check if the window is currently focused/active."""
    if only_window:
        cmd = ["wlrctl", "toplevel", "find", f"app_id:{win['app_id']}", "state:active"]
        try:
            return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.4).returncode == 0
        except Exception:
            return False

    if win.get("title"):
        cmd = ["wlrctl", "toplevel", "find", f"app_id:{win['app_id']}", f"title:{win['title']}", "state:active"]
        try:
            if subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.4).returncode == 0:
                return True
        except Exception:
            pass

    return False


def is_app_active(app_id: str) -> bool:
    """Check if any window of this app is active."""
    cmd = ["wlrctl", "toplevel", "find", f"app_id:{app_id}", "state:active"]
    try:
        return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.4).returncode == 0
    except Exception:
        return False


def focus_window(win: dict):
    """Focus a window using wlrctl."""
    # Try with app_id and title first if title is non-empty
    if win.get("title"):
        try:
            ret = subprocess.run(
                ["wlrctl", "toplevel", "focus", f"app_id:{win['app_id']}", f"title:{win['title']}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=0.6,
            )
            if ret.returncode == 0:
                return
        except Exception:
            pass

    # Fallback to app_id
    try:
        subprocess.run(
            ["wlrctl", "toplevel", "focus", f"app_id:{win['app_id']}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.6,
        )
    except Exception:
        pass


def minimize_window(win: dict):
    """Minimize a window using wlrctl."""
    try:
        subprocess.run(
            ["wlrctl", "toplevel", "minimize", f"app_id:{win['app_id']}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.6,
        )
    except Exception:
        pass


def launch_app(app_id: str, desktop_map: dict):
    """Launch an application by desktop ID or executable command."""
    # 1. Try gtk-launch
    if shutil.which("gtk-launch"):
        try:
            subprocess.Popen(
                ["gtk-launch", app_id],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return
        except Exception:
            pass

    # 2. Try desktop file Exec
    info = desktop_map.get(app_id)
    if info and info.get("Exec"):
        tokens = clean_exec_command(info["Exec"])
        if tokens:
            try:
                subprocess.Popen(
                    tokens,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                return
            except Exception:
                pass

    # 3. Fallback to direct binary in PATH
    if shutil.which(app_id):
        try:
            subprocess.Popen(
                [app_id],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return
        except Exception:
            pass


def main():
    desktop_map, alias_map = load_desktop_entries()

    args = sys.argv[1:]
    new_instance = False
    if "--new" in args:
        new_instance = True
        args.remove("--new")

    if "--list" in args:
        items = build_taskbar(desktop_map, alias_map)
        print("Taskbar Positions:")
        for idx, item in enumerate(items, 1):
            key = f"Meta+{idx % 10}"
            status = "pinned" if item["pinned"] else "running"
            wins = [f"{w['app_id']} ({w['title'][:25]})" for w in item["windows"]]
            win_str = f" -> {len(wins)} window(s): {', '.join(wins)}" if wins else " (not running)"
            print(f"  {idx:2d} [{key:7s}] {item['id']:25s} [{status:7s}]{win_str}")
        return

    if not args:
        print("Usage: taskbar-app [--new] <position: 1..10>")
        print("       taskbar-app --list")
        sys.exit(1)

    try:
        pos = int(args[0])
    except ValueError:
        print(f"Error: Invalid position '{args[0]}'", file=sys.stderr)
        sys.exit(1)

    # Allow 0 as 10th position (Meta+0)
    if pos == 0:
        pos = 10

    if pos < 1:
        sys.exit(0)

    items = build_taskbar(desktop_map, alias_map)
    target_idx = pos - 1
    if target_idx >= len(items):
        sys.exit(0)

    target = items[target_idx]
    wins = target["windows"]

    if new_instance or not wins:
        launch_app(target["id"], desktop_map)
        return

    # App is already running
    if len(wins) == 1:
        win = wins[0]
        if is_window_active(win, only_window=True):
            minimize_window(win)
        else:
            focus_window(win)
    else:
        # Multiple windows: check which one is active
        active_idx = -1
        for i, w in enumerate(wins):
            if is_window_active(w, only_window=False):
                active_idx = i
                break

        if active_idx == -1:
            # Check if any window of this app is active by app_id
            if is_app_active(wins[0]["app_id"]):
                # Active window title didn't match, advance to next
                focus_window(wins[1])
            else:
                # None active, focus first window
                focus_window(wins[0])
        else:
            # Cycle to next window
            next_idx = (active_idx + 1) % len(wins)
            focus_window(wins[next_idx])


if __name__ == "__main__":
    main()
