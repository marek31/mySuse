#!/bin/sh
# MMTerm Linux launcher for foot
dir=""
args=""
while [ $# -gt 0 ]; do
    case "$1" in
        --dir)
            dir="$2"
            shift 2
            ;;
        --close)
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ -n "$dir" ]; then
    expanded=$(eval echo "$dir")
    if [ -d "$expanded" ]; then
        cd "$expanded" 2>/dev/null || true
    fi
    if [ $# -gt 0 ]; then
        exec foot -D "$expanded" "$@"
    else
        exec foot -D "$expanded"
    fi
else
    if [ $# -gt 0 ]; then
        exec foot "$@"
    else
        exec foot
    fi
fi
