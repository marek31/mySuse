#!/bin/sh
# MMTerm Linux launcher for foot
dir=""
while [ $# -gt 0 ]; do
    case "$1" in
        --dir)
            dir="$2"
            shift 2
            ;;
        --close)
            shift
            ;;
        *)
            break
            ;;
    esac
done

# Strip .exe if invoked with Windows binary path and Linux binary exists
if [ $# -gt 0 ]; then
    cmd="$1"
    shift
    if [ "${cmd%.exe}" != "$cmd" ] && [ -x "${cmd%.exe}" ]; then
        cmd="${cmd%.exe}"
    fi
    set -- "$cmd" "$@"
fi

if [ -n "$dir" ]; then
    expanded=$(eval echo "$dir")
    if [ -d "$expanded" ]; then
        cd "$expanded" 2>/dev/null || true
    fi
    if [ $# -gt 0 ]; then
        exec foot -D "$expanded" "$@"
    else
        exec foot -D "$expanded"
    fi
else
    if [ $# -gt 0 ]; then
        exec foot "$@"
    else
        exec foot
    fi
fi
