<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <!-- Defer output control completely to kanshi for multi-monitor hotplugging & docking -->
    <autoOutputs>no</autoOutputs>
    <autoEnableOutputs>no</autoEnableOutputs>
  </core>

  <desktops>
    <number>4</number>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
    <popupTime>500</popupTime>
  </desktops>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <snapping>
    <range inner="10" outer="10" />
    <topMaximize>yes</topMaximize>
    <overlay enabled="yes">
      <placement>below</placement>
    </overlay>
  </snapping>

  <theme>
    <name>Tokyo-Night-Modern</name>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titleProvider>NLIMC</titleProvider>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
    </titlebar>
    <font place="ActiveWindow">
      <name>Inter</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Inter</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>Inter</name>
      <size>10</size>
    </font>
    <font place="OnScreenDisplay">
      <name>Inter</name>
      <size>11</size>
      <weight>bold</weight>
    </font>
  </theme>

  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="thumbnail" output="all" thumbnailLabelFormat="%T" />
    <fields>
      <field content="icon" width="5%" />
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <keyboard>
    <numlock>off</numlock>
    <repeatRate>100</repeatRate>
    <repeatDelay>200</repeatDelay>
    <default />

    <!-- Terminal & Launcher -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="Super_R" onRelease="yes">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="W-S-d">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- Essential Apps -->
    <keybind key="W-e">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="helium" />
    </keybind>
    <keybind key="W-S-b">
      <action name="Execute" command="floorp" />
    </keybind>
    <keybind key="W-a">
      <action name="Execute" command="noctalia msg panel-toggle control-center" />
    </keybind>
    <keybind key="W-comma">
      <action name="Execute" command="noctalia msg settings-toggle" />
    </keybind>
    <keybind key="S-Escape">
      <action name="Execute" command="foot -e btop" />
    </keybind>

    <!-- Window Management -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize" direction="both" />
    </keybind>
    <keybind key="W-Prior">
      <action name="ToggleMaximize" direction="both" />
    </keybind>
    <keybind key="W-Next">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-v">
      <action name="ToggleAlwaysOnTop" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" workspace="all" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" workspace="all" />
    </keybind>

    <!-- Snapping (Half-screen / Tiling) -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="SnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-Down">
      <action name="ToggleMaximize" direction="both" />
    </keybind>

    <!-- Workspaces 1..4 -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>

    <!-- Session & Lock -->
    <keybind key="W-l">
      <action name="Execute" command="noctalia msg lock || swaylock -f -c 1e1e2e" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Execute" command="noctalia msg lock || swaylock -f -c 1e1e2e" />
    </keybind>
    <keybind key="W-S-e">
      <action name="Exit" />
    </keybind>

    <!-- Cheat Sheet -->
    <keybind key="W-S-slash">
      <action name="Execute" command="imv -f -c 'bind &lt;Escape&gt; quit' $HOME/Pictures/Wallpapers/keys-labwc.png" />
    </keybind>
    <keybind key="W-question">
      <action name="Execute" command="imv -f -c 'bind &lt;Escape&gt; quit' $HOME/Pictures/Wallpapers/keys-labwc.png" />
    </keybind>

    <!-- Screenshots -->
    <keybind key="Print">
      <action name="Execute" command="noctalia msg screenshot-region" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="noctalia msg screenshot-fullscreen" />
    </keybind>

    <!-- Hardware Keys: Audio & Brightness -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="noctalia msg volume-up 5 || wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="noctalia msg volume-down 5 || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="noctalia msg volume-mute || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +5%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <accelProfile>adaptive</accelProfile>
    </device>
    <device category="non-touch">
      <accelProfile>adaptive</accelProfile>
      <pointerSpeed>0.2</pointerSpeed>
      <scrollFactor>0.67</scrollFactor>
    </device>
    <device category="touchpad">
      <accelProfile>adaptive</accelProfile>
      <tap>yes</tap>
      <scrollFactor>0.75</scrollFactor>
    </device>
    <device category="Bluetooth Mouse M336/M337/M535 Mouse">
      <accelProfile>adaptive</accelProfile>
      <pointerSpeed>0.2</pointerSpeed>
      <scrollFactor>0.67</scrollFactor>
    </device>
  </libinput>

  <windowRules>
    <windowRule identifier="pavucontrol" serverDecoration="yes">
      <action name="SnapToRegion" region="center" />
    </windowRule>
    <windowRule identifier="qalculate-qt" serverDecoration="yes">
      <action name="SnapToRegion" region="center" />
    </windowRule>
  </windowRules>
</labwc_config>
