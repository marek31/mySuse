    <item label="Application Launcher (fuzzel)">
      <action name="Execute" command="fuzzel" />
    </item>
    <separator />
    <item label="Web Browser (Helium)">
      <action name="Execute" command="helium" />
    </item>
    <item label="Web Browser (Opera)">
      <action name="Execute" command="opera" />
    </item>
    <item label="File Manager (Thunar)">
      <action name="Execute" command="thunar" />
    </item>
    <item label="Text Editor (Kate)">
      <action name="Execute" command="kate" />
