#!/bin/sh
# Started by labwc at login.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
kanshi &                                # monitor layouts: ~/.config/kanshi/config
idle-manager &                          # lock after 30 min on battery, 1 h on charger
easyeffects --gapplication-service &    # speaker profile (Dolby tuning of the X1 speakers)
noctalia -d &                           # bar, launcher, notifications, lock screen, polkit agent
update-notify &                         # notice when package updates are waiting
mm=$HOME/Desktop/code/MMAutoKey/MMAutoKey_linux   # MMAutoKey, from the mydata repo
[ -x "$mm" ] && ! pgrep -x MMAutoKey_linux >/dev/null && "$mm" &
