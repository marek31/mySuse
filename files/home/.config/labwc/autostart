#!/bin/sh
# Labwc autostart script for mySuse

# Import Wayland environment into systemd and DBus user sessions
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=labwc:wlroots XDG_SESSION_TYPE=wayland

# Display configuration & dynamic scaling (kanshi)
kanshi &

# Wallpaper: key cheat sheet (fallback to Great Wave if missing)
wp="$HOME/Pictures/Wallpapers/keys-labwc.png"
[ -f "$wp" ] || wp="$HOME/Pictures/Wallpapers/great-wave.jpg"
[ -f "$wp" ] && swaybg -i "$wp" -m fill &

# Notification daemon
mako &

# Polkit authentication agent
for agent in \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-kde-authentication-agent-1 \
    /usr/lib/polkit-kde-authentication-agent-1; do
    if [ -x "$agent" ]; then
        "$agent" &
        break
    fi
done

# Screen idle and locker
swayidle -w \
    timeout 300 'swaylock -f -c 1e1e2e' \
    timeout 600 'wlr-randr --output eDP-1 --off' \
    resume 'wlr-randr --output eDP-1 --on' \
    before-sleep 'swaylock -f -c 1e1e2e' &

# EasyEffects background service (Dolby Atmos speaker profile)
easyeffects --gapplication-service &

# Sfwbar taskbar (must start after display and environment are ready)
sfwbar &
