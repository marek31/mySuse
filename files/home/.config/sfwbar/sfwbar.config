# Sfwbar configuration for mySuse (Labwc session)
# Modern dark windowed taskbar with start menu, running task buttons, system tray, battery, and clock.

window#sfwbar {
  layer = "top";
  position = "bottom";
  exclusive-zone = true;
  height = 34;
}

layout {
  mirror = "*";
  format = "l|c|r";
}

# Left section: Start button + Pager + Taskbar
layout ":start" {
  button {
    value = "󰣛";
    action = "fuzzel";
    style = "start-button";
    tooltip = "Applications (Super+D)";
  }

  pager {
    style = "pager";
    rows = 1;
    pins = "1,2,3,4";
  }

  taskbar {
    rows = 1;
    icons = true;
    labels = true;
    sorting = "recent";
    style = "taskbar";
  }
}

# Center section: subtle spacer
layout ":center" {
}

# Right section: System Tray + Battery + Clock
layout ":end" {
  tray {
    rows = 1;
    style = "tray";
  }

  button {
    value = "󰕾";
    action = "pavucontrol";
    style = "quick-btn";
    tooltip = "Audio Settings (Super+A)";
  }

  battery {
    style = "battery";
  }

  label {
    value = Time("%a %d %b  %H:%M");
    style = "clock";
  }
}

css {
  * {
    font-family: "Inter", "JetBrains Mono", sans-serif;
    font-size: 13px;
    font-weight: 500;
  }

  window#sfwbar {
    background-color: rgba(26, 27, 38, 0.94);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #c0caf5;
  }

  button#start-button {
    background-color: transparent;
    color: #7aa2f7;
    font-size: 16px;
    padding: 0 12px;
    border: none;
    border-radius: 4px;
    margin: 2px 4px 2px 4px;
  }

  button#start-button:hover {
    background-color: rgba(122, 162, 247, 0.2);
    color: #bb9af7;
  }

  grid#pager {
    margin: 2px 6px;
  }

  button#pager-item {
    background-color: rgba(255, 255, 255, 0.05);
    color: #a9b1d6;
    border: none;
    border-radius: 4px;
    padding: 0 8px;
    margin: 0 2px;
    min-width: 20px;
  }

  button#pager-item:active, button#pager-item:focus {
    background-color: #7aa2f7;
    color: #1a1b26;
    font-weight: 700;
  }

  button#taskbar-item {
    background-color: rgba(255, 255, 255, 0.04);
    color: #c0caf5;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 4px;
    padding: 0 10px;
    margin: 2px 3px;
  }

  button#taskbar-item:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  button#taskbar-item:focus, button#taskbar-item:active {
    background-color: rgba(122, 162, 247, 0.18);
    border-bottom: 2px solid #7aa2f7;
    color: #ffffff;
  }

  grid#tray {
    margin: 2px 8px;
  }

  grid#tray button {
    background-color: transparent;
    border: none;
    padding: 0 4px;
  }

  button#quick-btn {
    background-color: transparent;
    border: none;
    color: #7aa2f7;
    padding: 0 8px;
    font-size: 14px;
  }

  button#quick-btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }

  label#battery {
    padding: 0 8px;
    color: #9ece6a;
  }

  label#clock {
    padding: 0 14px 0 6px;
    color: #c0caf5;
    font-weight: 600;
  }
}
