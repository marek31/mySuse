# Monitor layouts, applied on hotplug. Save the current layout as a new profile with display-setup.
profile laptop {
    output eDP-1 enable mode 1920x1200 position 0,0 scale 1.25
    exec noctalia msg config-reload
}

# laptop + any external screen (Dell G3223Q 4K) to the right; 1536 = 1920 / 1.25
profile docked {
    output eDP-1 enable mode 1920x1200 position 0,0 scale 1.25
    output * enable position 1536,0 scale 1.5
    exec noctalia msg config-reload
}
