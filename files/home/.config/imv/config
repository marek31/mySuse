# imv configuration - Tokyo Night themed, fullscreen by default, instant ESC exit
[options]
# Start fullscreen by default
fullscreen = true

# Scale mode: fit inside window/screen preserving aspect ratio
scaling_mode = full

# Loop back to first image when navigating past the last
loop_input = true

# Suppress built-in keybindings so all actions are strictly defined below
suppress_default_binds = true

# Bottom status overlay with file information and EXIF metadata
overlay = false
overlay_font = monospace:14
overlay_position_bottom = true
overlay_background_color = 1e1e2e
overlay_background_alpha = c0
overlay_text_color = c0caf5
overlay_text = [${imv_current_index}/${imv_file_count}] ${imv_current_file##*/} (${imv_width}x${imv_height} @ ${imv_scale}%)$(imv-info "$imv_current_file")

[binds]
# Instant exit
<Escape> = quit
q = quit

# Folder navigation (next / previous image in directory)
<Right> = next
<bracketright> = next
n = next
<Left> = prev
<bracketleft> = prev
p = prev
<BackSpace> = prev
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

# Zooming
<Up> = zoom 1
<Down> = zoom -1
<Shift+plus> = zoom 1
<equal> = zoom 1
+ = zoom 1
- = zoom -1
<minus> = zoom -1
i = zoom 1
o = zoom -1
a = zoom actual
r = reset
c = center

# Controls & Overlays
f = fullscreen
d = overlay
e = overlay
x = close
<Ctrl+r> = rotate by 90

# Animations & Slideshow
<period> = next_frame
<space> = toggle_playing
t = slideshow +1
<Shift+T> = slideshow -1
