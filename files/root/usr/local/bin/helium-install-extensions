#!/usr/bin/env python3
"""
Automatically installs recommended extensions for Helium browser.
Downloads .crx packages directly from Chrome Web Store CRX3 API,
unpacks them into ~/.local/share/helium/extensions/unpacked/<id>/,
and registers them in Helium's Preferences.
"""
import sys, os, io, struct, zipfile, json, urllib.request, shutil, subprocess
from pathlib import Path

EXTENSIONS = {
    "nngceckbapebfimnlniiiahkandclblb": "Bitwarden Password Manager",
    "mdjildafknihdffpkfmmpnpoiajfjnjd": "Consent-O-Matic",
    "mlomiejdfkolichcflejclcbmpeaniij": "Ghostery AdBlocker",
    "ldgfbffkinooeloadekpmfoklnobpien": "Raindrop.io",
    "khncfooichmfjbepaaaebmommgaepoid": "Unhook - Remove YouTube Recommended Videos",
    "penndbmahnpapepljikkjmakcobdahne": "Video Downloader Pro",
    "agadcopafaojndinhloilcanpfpbonbk": "Youtube Volume Scroll"
}

def is_helium_running():
    try:
        out = subprocess.check_output(["pgrep", "-f", "/opt/helium/helium"], stderr=subprocess.DEVNULL)
        return len(out.strip()) > 0
    except subprocess.CalledProcessError:
        return False

def download_and_unpack_extensions():
    home = Path.home()
    crx_dir = home / ".local/share/helium/extensions"
    crx_dir.mkdir(parents=True, exist_ok=True)
    unpacked_base = crx_dir / "unpacked"
    unpacked_base.mkdir(parents=True, exist_ok=True)

    for ext_id, friendly_name in EXTENSIONS.items():
        dest_dir = unpacked_base / ext_id
        manifest_file = dest_dir / "manifest.json"
        crx_path = crx_dir / f"{ext_id}.crx"

        if not manifest_file.exists():
            if not crx_path.exists() or crx_path.stat().st_size == 0:
                print(f"Downloading {friendly_name} ({ext_id})...")
                url = (
                    f"https://clients2.google.com/service/update2/crx"
                    f"?response=redirect&prod=chromecrx&prodchannel=&prodversion=157.0.8103.38"
                    f"&lang=en-US&acceptformat=crx3,puff&x=id%3D{ext_id}%26installsource%3Dondemand%26uc"
                )
                req = urllib.request.Request(
                    url,
                    headers={
                        "User-Agent": (
                            "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                            "(KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
                        )
                    }
                )
                try:
                    with urllib.request.urlopen(req, timeout=30) as resp:
                        data = resp.read()
                    crx_path.write_bytes(data)
                except Exception as e:
                    print(f"  Warning: failed to download {friendly_name}: {e}")
                    continue
            else:
                data = crx_path.read_bytes()

            # Unpack CRX3
            try:
                magic = data[:4]
                if magic != b'Cr24':
                    print(f"  Warning: {friendly_name} is not a valid CRX3 package")
                    continue
                header_len = struct.unpack('<I', data[8:12])[0]
                zip_bytes = data[12 + header_len:]

                if dest_dir.exists():
                    shutil.rmtree(dest_dir)
                dest_dir.mkdir(parents=True, exist_ok=True)

                with zipfile.ZipFile(io.BytesIO(zip_bytes)) as z:
                    z.extractall(dest_dir)
                print(f"  -> Successfully unpacked {friendly_name} into {dest_dir}")
            except Exception as e:
                print(f"  Warning: failed to unpack {friendly_name}: {e}")

def register_in_preferences():
    home = Path.home()
    pref_path = home / ".config/net.imput.helium/Default/Preferences"
    if not pref_path.exists():
        return
    try:
        with open(pref_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"Warning: could not read Preferences: {e}")
        return

    settings = data.setdefault("extensions", {}).setdefault("settings", {})
    pinned = data.setdefault("extensions", {}).setdefault("pinned_extensions", [])

    unpacked_base = home / ".local/share/helium/extensions/unpacked"
    modified = False

    for ext_dir in unpacked_base.iterdir():
        if not ext_dir.is_dir():
            continue
        manifest_file = ext_dir / "manifest.json"
        if not manifest_file.exists():
            continue
        ext_id = ext_dir.name
        try:
            manifest = json.loads(manifest_file.read_text("utf-8", "ignore"))
        except Exception:
            continue

        if ext_id not in settings or settings[ext_id].get("location") != 4:
            settings[ext_id] = {
                "account_extension_type": 0,
                "active_permissions": {
                    "api": manifest.get("permissions", []),
                    "explicit_host": manifest.get("host_permissions", []),
                    "manifest_permissions": [],
                    "scriptable_host": []
                },
                "commands": {},
                "content_settings": [],
                "creation_flags": 38,
                "disable_reasons": [],
                "first_install_time": "13438713438565246",
                "from_webstore": False,
                "granted_permissions": {
                    "api": manifest.get("permissions", []),
                    "explicit_host": manifest.get("host_permissions", []),
                    "manifest_permissions": [],
                    "scriptable_host": []
                },
                "has_started_service_worker": True,
                "incognito_content_settings": [],
                "incognito_preferences": {},
                "last_update_time": "13438713438565246",
                "location": 4,
                "manifest": manifest,
                "path": str(ext_dir.resolve()),
                "preferences": {},
                "regular_only_preferences": {},
                "was_installed_by_default": False,
                "was_installed_by_oem": False,
                "was_pinned_by_default": False,
                "withholding_permissions": False
            }
            modified = True

        if ext_id not in pinned:
            pinned.append(ext_id)
            modified = True

    if modified:
        try:
            with open(pref_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            print("Successfully registered and pinned extensions in Preferences.")
        except Exception as e:
            print(f"Warning: could not write Preferences: {e}")

if __name__ == "__main__":
    download_and_unpack_extensions()
    # Note: unpacked extensions are loaded at launch via --load-extension in /usr/local/bin/helium.
    # Do not rewrite Default/Preferences directly, as Chromium's HMAC protection resets settings on tampering.
