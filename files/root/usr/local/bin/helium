#!/bin/bash
# Launch Helium with hardware acceleration, secret store, and unpacked extensions
EXT_BASE="${XDG_DATA_HOME:-$HOME/.local/share}/helium/extensions/unpacked"
LOAD_EXTS=()

if [[ -d "$EXT_BASE" ]]; then
    for ext_dir in "$EXT_BASE"/*; do
        if [[ -d "$ext_dir" && -f "$ext_dir/manifest.json" ]]; then
            LOAD_EXTS+=("$ext_dir")
        fi
    done
fi

if [[ -d "$HOME/Desktop/code/MMBrowserSync/extension" ]]; then
    LOAD_EXTS+=("$HOME/Desktop/code/MMBrowserSync/extension")
fi

ARGS=(--password-store=gnome-libsecret --enable-features=VaapiVideoDecodeLinuxGL)
if [[ ${#LOAD_EXTS[@]} -gt 0 ]]; then
    ARGS+=("--load-extension=$(IFS=,; echo "${LOAD_EXTS[*]}")")
fi

exec /opt/helium/helium-wrapper "${ARGS[@]}" "$@"
