#!/usr/bin/env python3
"""
Automatically installs recommended extensions for Helium browser.
- Bitwarden Password Manager
- Consent-O-Matic
- Ghostery AdBlocker
- Raindrop.io
- uBlock Origin
- Unhook - Remove YouTube Recommended Videos
- Video Downloader Pro
- Youtube Volume Scroll
"""
import sys, os, io, struct, zipfile, json, urllib.request, shutil
from pathlib import Path

EXTENSIONS = {
    "nngceckbapebfimnlniiiahkandclblb": "Bitwarden Password Manager",
    "mdjildafknihdffpkfmmpnpoiajfjnjd": "Consent-O-Matic",
    "mlomiejdfkolichcflejclcbmpeaniij": "Ghostery AdBlocker",
    "ldgfbffkinooeloadekpmfoklnobpien": "Raindrop.io",
    "khncfooichmfjbepaaaebmommgaepoid": "Unhook - Remove YouTube Recommended Videos",
    "penndbmahnpapepljikkjmakcobdahne": "Video Downloader Pro",
    "agadcopafaojndinhloilcanpfpbonbk": "Youtube Volume Scroll"
}

UBLOCK_ID = "cjpalhdlnbpafiamejdnhcphjbkeiagm"

def install_ublock(prof_ext_dir: Path, ext_dir: Path):
    target_dir = prof_ext_dir / UBLOCK_ID
    if target_dir.exists() and any(target_dir.iterdir()):
        return
    print("Installing uBlock Origin from GitHub release...")
    try:
        req = urllib.request.Request(
            "https://api.github.com/repos/gorhill/uBlock/releases/latest",
            headers={"User-Agent": "mySuse-helium-installer"}
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            rel = json.loads(resp.read().decode())
        zip_url = None
        for asset in rel.get("assets", []):
            if asset.get("name", "").endswith(".chromium.zip"):
                zip_url = asset.get("browser_download_url")
                break
        if not zip_url:
            print("  Warning: could not find chromium zip asset for uBlock")
            return
        with urllib.request.urlopen(zip_url, timeout=30) as resp:
            zip_bytes = resp.read()
        with zipfile.ZipFile(io.BytesIO(zip_bytes)) as z:
            manifest_data = json.loads(z.read("uBlock0.chromium/manifest.json").decode("utf-8", "ignore"))
            ver = manifest_data.get("version", "1.76.0")
            dest = prof_ext_dir / UBLOCK_ID / ver
            dest.mkdir(parents=True, exist_ok=True)
            for item in z.infolist():
                if item.filename.startswith("uBlock0.chromium/") and not item.filename.endswith("/"):
                    rel_path = item.filename[len("uBlock0.chromium/"):]
                    target_file = dest / rel_path
                    target_file.parent.mkdir(parents=True, exist_ok=True)
                    with z.open(item) as src_f, open(target_file, "wb") as dst_f:
                        shutil.copyfileobj(src_f, dst_f)
        cfg = {"external_update_url": "https://clients2.google.com/service/update2/crx"}
        (ext_dir / f"{UBLOCK_ID}.json").write_text(json.dumps(cfg, indent=2))
        print(f"  -> Successfully installed uBlock Origin v{ver}")
    except Exception as e:
        print(f"  Warning: failed to install uBlock Origin: {e}")

def install_extensions():
    home = Path.home()
    crx_dir = home / ".local/share/helium/extensions"
    crx_dir.mkdir(parents=True, exist_ok=True)
    ext_dir = home / ".config/net.imput.helium/External Extensions"
    ext_dir.mkdir(parents=True, exist_ok=True)
    prof_ext_dir = home / ".config/net.imput.helium/Default/Extensions"
    prof_ext_dir.mkdir(parents=True, exist_ok=True)

    install_ublock(prof_ext_dir, ext_dir)

    for ext_id, friendly_name in EXTENSIONS.items():
        target_dir = prof_ext_dir / ext_id
        if target_dir.exists() and any(target_dir.iterdir()):
            continue
        print(f"Installing {friendly_name} ({ext_id})...")
        url = (
            f"https://clients2.google.com/service/update2/crx"
            f"?response=redirect&prod=chromecrx&prodchannel=&prodversion=157.0.8103.38"
            f"&lang=en-US&acceptformat=crx3,puff&x=id%3D{ext_id}%26installsource%3Dondemand%26uc"
        )
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": (
                    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                    "(KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
                )
            }
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = resp.read()
        except Exception as e:
            print(f"  Warning: failed to download {friendly_name}: {e}")
            continue

        crx_path = crx_dir / f"{ext_id}.crx"
        crx_path.write_bytes(data)

        # Unpack CRX3
        try:
            f = io.BytesIO(data)
            magic = f.read(4)
            if magic != b'Cr24':
                print(f"  Warning: {friendly_name} is not a valid CRX")
                continue
            _ = struct.unpack('<I', f.read(4))[0]
            header_len = struct.unpack('<I', f.read(4))[0]
            f.seek(12 + header_len)
            zip_bytes = f.read()

            with zipfile.ZipFile(io.BytesIO(zip_bytes)) as z:
                manifest_data = json.loads(z.read("manifest.json").decode("utf-8", "ignore"))
                version_str = manifest_data.get("version", "1.0.0")
                dest = prof_ext_dir / ext_id / version_str
                dest.mkdir(parents=True, exist_ok=True)
                z.extractall(dest)

            cfg = {
                "external_crx": str(crx_path.resolve()),
                "external_version": version_str
            }
            (ext_dir / f"{ext_id}.json").write_text(json.dumps(cfg, indent=2))
            print(f"  -> Successfully installed {friendly_name} v{version_str}")
        except Exception as e:
            print(f"  Warning: failed to unpack {friendly_name}: {e}")

if __name__ == "__main__":
    install_extensions()
