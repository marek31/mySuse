#!/bin/sh
# Labwc + Noctalia session for mySuse: modern stacking Wayland compositor.
# Started by the display manager (SDDM). Log: ~/.local/state/labwc/<date>-labwc.log, 14 days kept.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc:wlroots
export XDG_SESSION_DESKTOP=labwc
logdir=${XDG_STATE_HOME:-$HOME/.local/state}/labwc
mkdir -p "$logdir"
find "$logdir" -name '*-labwc.log' -mtime +14 -delete 2>/dev/null
log=$logdir/$(date +%F)-labwc.log
exec dbus-run-session labwc >>"$log" 2>&1
