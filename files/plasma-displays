#!/bin/sh
# Plasma autostart: native mode on every connected screen and default scales (laptop panel @SCALE@,
# 4K monitors @SCALE_4K@, others 1). For VM displays (Virtual*), ensures at least 1600h (e.g. 2560x1600).
# Each connector only once (stamp), so changes made later in System Settings stick;
# run with -f or delete ~/.local/state/mysuse/plasma-displays to apply again.
dir=${XDG_STATE_HOME:-$HOME/.local/state}/mysuse/plasma-displays
[ "${1:-}" = "-f" ] || [ "${1:-}" = "--force" ] && rm -rf "$dir"
mkdir -p "$dir"
tab=$(printf '\t')
kscreen-doctor -j 2>/dev/null | jq -r '.outputs[] | select(.connected) |
    .name as $name |
    (if ($name | test("Virtual|VMware")) then
       ([.modes[] | select(.size.height >= 1600)] | sort_by(.size.height, .size.width) | .[0].id)
       // ([.modes[]] | sort_by(.size.height, .size.width) | reverse | .[0].id)
       // (.preferredModes[0] // .currentModeId)
     else
       (.preferredModes[0] // .currentModeId)
     end) as $mode |
    ([.modes[] | select(.size.width >= 3840)] | length) as $big |
    [$name, $mode, $big] | @tsv' 2>/dev/null |
while IFS=$tab read -r name mode big; do
    [ -z "$name" ] && continue
    [ -e "$dir/$name" ] && continue
    case $name in
    eDP*)
        scale=@SCALE@
        kscreen-doctor "output.$name.mode.$mode" "output.$name.scale.$scale" 2>/dev/null && touch "$dir/$name"
        ;;
    Virtual*|VMware*)
        scale=1
        if [ "$big" -gt 0 ]; then scale=@SCALE_4K@; fi
        kscreen-doctor "output.$name.mode.$mode" "output.$name.scale.$scale" 2>/dev/null ||
            kscreen-doctor "output.$name.mode.2560x1600" "output.$name.scale.$scale" 2>/dev/null ||
            kscreen-doctor "output.$name.mode.2560x1600@60" "output.$name.scale.$scale" 2>/dev/null || true
        touch "$dir/$name"
        ;;
    *)
        if [ "$big" -gt 0 ]; then scale=@SCALE_4K@; else scale=1; fi
        kscreen-doctor "output.$name.mode.$mode" "output.$name.scale.$scale" 2>/dev/null && touch "$dir/$name"
        ;;
    esac
done
