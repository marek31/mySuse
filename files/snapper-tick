#!/bin/sh
# Run periodically: timeline snapshot of every snapper config, then prune by the
# TIMELINE_LIMIT_* / NUMBER_LIMIT values. Once an hour also refresh the grub snapshot menu.
[ -f /etc/sysconfig/snapper ] && . /etc/sysconfig/snapper
[ -f /etc/conf.d/snapper ] && . /etc/conf.d/snapper
configs=""
for c in ${SNAPPER_CONFIGS:-"root home"}; do
    [ -f "/etc/snapper/configs/$c" ] && configs="$configs $c"
done
configs=${configs:-root}
for c in $configs; do
    snapper --no-dbus -c "$c" create -c timeline -d "timeline" 2>/dev/null || logger -t snapper-tick "create $c failed"
    snapper --no-dbus -c "$c" cleanup timeline 2>/dev/null || logger -t snapper-tick "timeline cleanup $c failed"
    snapper --no-dbus -c "$c" cleanup number 2>/dev/null || logger -t snapper-tick "number cleanup $c failed"
done
if [ "$(date +%M)" -lt 15 ]; then
    grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || update-bootloader >/dev/null 2>&1 || logger -t snapper-tick "grub-mkconfig failed"
fi
